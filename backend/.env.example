# ===== 应用 =====
APP_NAME=AutoTrade
APP_ENV=dev
LOG_LEVEL=INFO

# ===== OKX 凭据（模拟盘与主网是两套 Key，切勿混用） =====
# 模拟盘 Key 获取：OKX 官网 -> 交易 -> 模拟交易 -> 个人中心 -> 模拟盘 API
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# ===== OKX 连接 =====
OKX_BASE_URL=https://www.okx.com
# true=模拟盘（推荐），false=真实盘（请务必二次确认）
OKX_SIMULATED=true
OKX_TIMEOUT=10

# 可选：本地代理（如 Clash），留空表示直连
OKX_PROXY=

# 可选：本机 DNS 被污染时，把 OKX 域名强制解析到有效 IP
# 已实测可用：43.207.243.170（如失效请重新解析）
OKX_RESOLVE_IP=

# ===== 存储 =====
DATABASE_URL=sqlite:///./autotrade.db

# ===== 行情（多标的订阅，逗号分隔，首个为默认标的） =====
MARKET_INST_IDS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP
MARKET_BAR=1m

# ===== 策略（双均线 + ATR 止损） =====
STRATEGY_FAST=9
STRATEGY_SLOW=21
STRATEGY_ATR_PERIOD=14
STRATEGY_ATR_MULTIPLE=1.5
STRATEGY_SIZE=0.01
STRATEGY_LEVER=10
STRATEGY_COOLDOWN_BARS=3
# 有浮盈时是否让止损随 ATR 逐步移动（true/false）
STRATEGY_TRAILING=true

# ===== 风控 =====
RISK_MAX_SIZE=1
RISK_MAX_NOTIONAL=1000
RISK_MAX_DRAWDOWN_PCT=20
